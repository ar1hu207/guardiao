# Copie para .env e ajuste. Nada disso fica fixo no código (app/config.py lê daqui ou do ambiente).

# String de conexão SQLAlchemy
DATABASE_URL=sqlite:///./guardiao_risco.db
# Exemplo PostgreSQL (precisa de: pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://guardiao:troque-a-senha@localhost:5432/guardiao_risco

# CSV exportado pelo notebook de ML
ZONAS_CSV_PATH=../ml/zonas_risco.csv

# Na inicialização: aplica as migrações e importa o CSV se o banco estiver vazio
APLICAR_MIGRACOES_NA_INICIALIZACAO=true
IMPORTAR_CSV_SE_VAZIO=true

FUSO_HORARIO=America/Sao_Paulo
RAIO_PADRAO_KM=2.0
